{
	"name": "@repo/ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "oxlint --type-aware",
		"check-types": "tsc --noEmit",
		"generate-theme": "bun ./scripts/generateDefaultTheme.ts"
	},
	"imports": {
		"#utils": "./src/utils/index.ts",
		"#theme": "./src/theme.css.ts",
		"#typography": "./src/typography.css.ts",
		"#hooks/*": "./src/hooks/*/index.ts"
	},
	"exports": {
		"./components/*": [
			"./src/components/*/index.ts",
			"./src/components/*.tsx"
		],
		"./hooks/*": [
			"./src/hooks/*/index.ts",
			"./src/hooks/*.tsx",
			"./src/hooks/*.ts"
		],
		"./theme": "./src/theme.css.ts",
		"./sprinkles": "./src/sprinkles.css.ts",
		"./generator": "./src/generator.ts",
		"./fonts": "./src/fonts.ts",
		"./typography": "./src/typography.css.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.0.0",
		"@dessert-box/react": "^0.7.5",
		"@fontsource-variable/roboto-flex": "^5.2.8",
		"@materialx/material-color-utilities": "^0.4.8",
		"@uidotdev/usehooks": "^2.4.1",
		"@vanilla-extract/css-utils": "^0.1.6",
		"@vanilla-extract/dynamic": "2.1.5",
		"@vanilla-extract/sprinkles": "^1.6.5",
		"merge-props": "^6.0.0"
	},
	"devDependencies": {
		"@repo/oxlint-config": "workspace:",
		"@types/bun": "^1.3.5",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vanilla-extract/css": "^1.17.5",
		"@vanilla-extract/recipes": "^0.5.7",
		"oxlint": "1.32.0",
		"oxlint-tsgolint": "0.8.6",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"@vanilla-extract/css": "^1.17.5",
		"@vanilla-extract/recipes": "^0.5.7"
	}
}
