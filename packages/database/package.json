{
	"name": "@repo/database",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema.ts"
	},
	"scripts": {
		"with-env": "dotenvx run -f ../../.env --",
		"lint": "oxlint --type-aware",
		"check-types": "tsc --noEmit",
		"db:generate": "bun with-env drizzle-kit generate",
		"db:migrate": "bun with-env drizzle-kit migrate",
		"db:studio": "bun with-env drizzle-kit studio"
	},
	"dependencies": {
		"drizzle-kit": "0.31.8",
		"drizzle-orm": "0.45.1",
		"postgres": "^3.4.7"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^1.51.1",
		"@repo/oxlint-config": "workspace:",
		"@types/pg": "8.16.0",
		"oxlint": "1.32.0",
		"oxlint-tsgolint": "^0.8.6",
		"typescript": "catalog:"
	}
}
