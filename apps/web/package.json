{
	"name": "@repo/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#features/*": "./src/features/*",
		"#*": "./src/*.ts"
	},
	"scripts": {
		"with-env": "dotenvx run -f ../../.env --",
